{
  "name": "grp-click",
  "productName": "GRP Click",
  "version": "1.1.0",
  "description": "GRP Live slide control: Bitfocus Companion to PowerPoint and Keynote",
  "main": "main.js",
  "author": "GRP Live",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\" && node test/updates.check.js",
    "dist": "electron-builder --mac --win"
  },
  "build": {
    "appId": "live.grp.click",
    "productName": "GRP Click",
    "copyright": "© GRP Live",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "GRP Click changes slides in PowerPoint or Keynote when you press buttons in Bitfocus Companion."
      },
      "artifactName": "GRP-Click-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "GRP Click",
      "artifactName": "GRP-Click-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "GRP Click",
      "artifactName": "GRP-Click-Setup-${version}.${ext}"
    },
    "electronLanguages": [
      "en",
      "en-GB"
    ]
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  }
}
