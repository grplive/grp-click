#!/bin/sh
# Runs as root after the .pkg is installed.
# Starts the receiver for the user who is logged in right now, and links it onto the PATH.

ln -sf /usr/local/grp-click/grp-click-receiver /usr/local/bin/grp-click-receiver

CONSOLE_USER=$(stat -f%Su /dev/console)
if [ -z "$CONSOLE_USER" ] || [ "$CONSOLE_USER" = "root" ] || [ "$CONSOLE_USER" = "loginwindow" ]; then
	# Nobody is logged in. The agent will start at the next login.
	exit 0
fi

USER_UID=$(id -u "$CONSOLE_USER")
launchctl bootout "gui/$USER_UID/com.grp.click.receiver" 2>/dev/null
launchctl bootstrap "gui/$USER_UID" /Library/LaunchAgents/com.grp.click.receiver.plist 2>/dev/null
exit 0
